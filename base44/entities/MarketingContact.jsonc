{
  "name": "MarketingContact",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Contact name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email for cross-channel suppression"
    },
    "phone": {
      "type": "string",
      "description": "E.164 phone number, e.g. +17145551234"
    },
    "segment": {
      "type": "string",
      "enum": [
        "consumer_weight_loss",
        "consumer_mens_health",
        "consumer_womens_health",
        "consumer_longevity",
        "consumer_skincare",
        "b2b_operator",
        "ruo_professional"
      ],
      "description": "Audience segment used for targeting"
    },
    "sms_consent": {
      "type": "boolean",
      "default": false,
      "description": "Express written consent to receive marketing SMS"
    },
    "voice_consent": {
      "type": "boolean",
      "default": false,
      "description": "Express written consent to receive marketing voice calls"
    },
    "consent_source": {
      "type": "string",
      "description": "Where consent was captured (form name, URL, import file)"
    },
    "consent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When consent was captured"
    },
    "opt_out": {
      "type": "boolean",
      "default": false,
      "description": "Suppressed from all SMS and voice"
    },
    "opt_out_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "phone",
    "segment"
  ]
}