{
  "name": "RUOProduct",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string",
      "description": "Internal catalog SKU"
    },
    "slug": {
      "type": "string",
      "description": "URL slug"
    },
    "display_name": {
      "type": "string",
      "description": "Catalog name shown on the storefront"
    },
    "category": {
      "type": "string",
      "enum": [
        "peptides",
        "metabolic",
        "longevity",
        "supplies"
      ],
      "description": "Catalog category used by the storefront filter"
    },
    "cas_number": {
      "type": "string",
      "description": "CAS registry number (or 'Mixture' for blends)"
    },
    "mg": {
      "type": "number",
      "description": "Fill mass per vial in mg"
    },
    "form": {
      "type": "string",
      "description": "Physical form, e.g. lyophilized powder"
    },
    "purity_pct": {
      "type": "number",
      "description": "HPLC purity for the released lot. Leave empty until the lab report is on file."
    },
    "lot_number": {
      "type": "string",
      "description": "Current lot, e.g. MRV-BPC-2601"
    },
    "lab_name": {
      "type": "string",
      "description": "Independent testing laboratory"
    },
    "lab_accreditation": {
      "type": "string",
      "description": "Laboratory accreditation, e.g. ISO/IEC 17025:2017"
    },
    "report_url": {
      "type": "string",
      "description": "Link to the report hosted by the testing laboratory"
    },
    "verification_api_url": {
      "type": "string",
      "description": "Lot verification endpoint for this product"
    },
    "retail_price": {
      "type": "number",
      "description": "Unit price for 1-2 units (USD)"
    },
    "tier_3_5_price": {
      "type": "number",
      "description": "Unit price when 3-5 units of this line are ordered (USD)"
    },
    "tier_6_plus_price": {
      "type": "number",
      "description": "Unit price when 6 or more units of this line are ordered (USD)"
    },
    "cases_available": {
      "type": "integer",
      "default": 0,
      "description": "Units currently available to ship"
    },
    "lead_time_days": {
      "type": "integer",
      "description": "Business days from order to dispatch"
    },
    "coa_status": {
      "type": "string",
      "enum": [
        "released",
        "pending"
      ],
      "default": "pending",
      "description": "released = lab report on file; pending = awaiting the lab's release"
    },
    "storage_note": {
      "type": "string",
      "description": "Storage and handling instruction"
    },
    "safety_sheet_url": {
      "type": "string",
      "description": "Safety data sheet link"
    },
    "bulk_only": {
      "type": "boolean",
      "default": false,
      "description": "Sold in case quantities only"
    },
    "in_stock": {
      "type": "boolean",
      "default": true,
      "description": "Derived availability flag for the storefront"
    }
  },
  "required": [
    "sku",
    "slug",
    "display_name",
    "category",
    "lot_number",
    "coa_status",
    "retail_price"
  ]
}