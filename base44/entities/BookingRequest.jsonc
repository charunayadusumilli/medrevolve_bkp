{
  "name": "BookingRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Requester full name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Requester email address"
    },
    "company": {
      "type": "string",
      "description": "Company / organization name"
    },
    "partnership_interest": {
      "type": "string",
      "enum": [
        "Implementation",
        "Infrastructure",
        "Channel",
        "Strategic",
        "Not sure yet"
      ],
      "description": "Which partnership model the requester is interested in"
    },
    "message": {
      "type": "string",
      "description": "Message or context from the requester"
    },
    "source": {
      "type": "string",
      "description": "Where the request originated (e.g. Partnerships Page)"
    },
    "booking_type": {
      "type": "string",
      "description": "Type of request (e.g. Partnership Inquiry)"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "closed"
      ],
      "default": "new",
      "description": "Internal follow-up status"
    }
  },
  "required": [
    "name",
    "email"
  ]
}