{
  "name": "PartnerReferral",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name of the person submitting the referral or catalog request"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email for the referral"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone"
    },
    "business_name": {
      "type": "string",
      "description": "Business name of the referred operator or research buyer"
    },
    "website_url": {
      "type": "string",
      "description": "Website URL of the referred business"
    },
    "service_interest": {
      "type": "string",
      "description": "Service the referral wants: Processing readiness audit, Custom development, Marketing engine, LegitScript buildout, Full platform, RUO bulk supply"
    },
    "referred_by": {
      "type": "string",
      "description": "Who or what referred this lead"
    },
    "notes": {
      "type": "string",
      "description": "Additional context captured with the referral"
    },
    "partner_id": {
      "type": "string",
      "description": "Partner ID for commission-tracked referrals"
    },
    "customer_email": {
      "type": "string",
      "format": "email",
      "description": "Referred customer email on commission-tracked referrals"
    },
    "product_id": {
      "type": "string",
      "description": "Product purchased on commission-tracked referrals"
    },
    "order_value": {
      "type": "number",
      "description": "Total order value on commission-tracked referrals"
    },
    "partner_earnings": {
      "type": "number",
      "description": "Partner earnings from this referral"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "pending",
        "qualified",
        "paid",
        "cancelled"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "green",
        "gray"
      ],
      "default": "new",
      "description": "new = intake awaiting follow-up, pending = commission referral awaiting qualification"
    },
    "qualified_date": {
      "type": "string",
      "format": "date-time",
      "description": "When referral qualified"
    },
    "paid_date": {
      "type": "string",
      "format": "date-time",
      "description": "When partner was paid"
    }
  }
}