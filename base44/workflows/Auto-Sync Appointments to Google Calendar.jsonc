{
  "name": "Auto-Sync Appointments to Google Calendar",
  "description": "Auto-sync new appointments to Google Calendar with Meet link",
  "trigger": {
    "condition": "${ (.trigger.data.google_event_id == null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Appointment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_sync_appointments_to_google_calendar",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncGoogleCalendar",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncGoogleCalendar"
  }
}