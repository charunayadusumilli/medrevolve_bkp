{
  "name": "Welcome Email on Patient Registration",
  "description": "Sends a welcome email to new patients immediately after they complete registration (PatientIntake created), confirming account creation and next steps.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "PatientIntake"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "welcome_email_on_patient_registration",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNewSignup",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyNewSignup"
  }
}