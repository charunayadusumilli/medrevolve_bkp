{
  "name": "Connect Now \u2014 Status Check (test)",
  "description": "Calls connectNow status to confirm calendar availability reads work. Safe to run any time.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 1 1 *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "action": "status"
            },
            "function_name": "connectNow"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "connect_now_status",
      "namespace": "base44",
      "version": "1.0"
    }
  }
