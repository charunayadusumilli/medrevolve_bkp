{
  "name": "Mailbox \u2014 Remove Old Emoji Labels (one-time)",
  "description": "Deletes the legacy MedRevolve/emoji Gmail labels. Mail is untouched; it keeps its new plain folders.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 1 1 *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "mode": "finalize"
            },
            "function_name": "mailboxOrganizer"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "mailbox_finalize",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}