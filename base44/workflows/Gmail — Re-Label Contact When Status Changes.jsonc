{
  "name": "Gmail \u2014 Re-Label Contact When Status Changes",
  "description": "Moves Gmail label when a contact request status changes (New \u2192 Contacted \u2192 Qualified \u2192 Closed)",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ContactRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gmail_re_label_contact_when_status_changes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "classifyAndLabelEmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "classifyAndLabelEmail"
  }
}