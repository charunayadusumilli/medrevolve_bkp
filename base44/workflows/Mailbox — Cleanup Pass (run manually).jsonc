{
  "name": "Mailbox \u2014 Cleanup Pass (auto until done)",
  "description": "Organizes existing mail in rned@medrevolve.com, 400 messages every 10 minutes, until the whole mailbox is done. Then it is a no-op; pause or archive it once MailboxState.cleanup.done is true.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "max": 400,
              "mode": "apply"
            },
            "function_name": "mailboxOrganizer"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "mailbox_cleanup_pass",
      "namespace": "base44",
      "version": "1.1"
    }
  }
}